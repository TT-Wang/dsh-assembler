{
  "name": "@dsh-external/dsh-assembler",
  "description": "Vibe-assembly for DSH (DeepSeek Harness): turn a natural-language agent requirement into a composed agent preset by matching the capability catalog. Registers the /assemble command.",
  "version": "0.0.1",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib/**/*",
    "capabilities.yml",
    "presets/**/*",
    "frontends/**/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "link:dsh": "node scripts/link-dsh.mjs",
    "parts:install": "for d in generated/*/; do (cd \"$d\" && npm install --no-audit --no-fund); done",
    "test": "npm run build && node scripts/lock-check.mjs && node scripts/catalog-report.mjs --check && node tests-naming.mjs && node tests-verify.mjs && node tests-federation.mjs && node tests-spec-intake.mjs && node tests-yaml-write.mjs && node tests-catalog-layer.mjs && node tests-incremental.mjs && node tests-equipment.mjs && node tests-frontend.mjs",
    "lock:check": "node scripts/lock-check.mjs",
    "bench": "node scripts/assembly-bench.mjs",
    "index:add": "node scripts/index-add.mjs scaffold",
    "index:verify": "node scripts/index-add.mjs verify",
    "index:register": "node scripts/index-add.mjs register",
    "index:check": "node scripts/index-add.mjs check-all",
    "index:auto": "node scripts/index-add.mjs auto",
    "solution": "node scripts/solution.mjs",
    "catalog:report": "node scripts/catalog-report.mjs",
    "catalog:check": "node scripts/catalog-report.mjs --check",
    "build:client": "node scripts/build-client.mjs"
  },
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-commands": "^0.0.1-rc.1 || ^0.1.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.0.1-rc.1 || ^0.1.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1 || ^0.1.0-rc.1",
    "dsh-better-sidebar": "*",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.23.1",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "js-yaml": "^4.1.0"
  },
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependenciesMeta": {
    "dsh-better-sidebar": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
